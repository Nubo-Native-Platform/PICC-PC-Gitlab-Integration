# ==============================================================================
# PICC-PC-Gitlab-Integration - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens
SERVER_PORT=8080

# Active Spring Profile (e.g., main, dev, local)
SPRING_PROFILES_ACTIVE=main

# ------------------------------------------------------------------------------
# 2. GitLab REST API v4 Integration (Primary Client)
# ------------------------------------------------------------------------------
# Feign client identifier
FEIGN_NAME=gitlab-client

# Base URL of your GitLab instance (GitLab.com or Self-Hosted CE/EE)
FEIGN_URL=https://gitlab.example.com

# GitLab REST API version prefix
FEIGN_URL_API=/api/v4

# Administrator or Scoped Personal Access Token (PAT)
# Required Scopes: api, read_user, read_api, read_repository, write_repository
FEIGN_APITOKEN=glpat-yourSecretAdminTokenHere

# ------------------------------------------------------------------------------
# 3. Secondary / Scoped NNP GitLab Client (Optional)
# ------------------------------------------------------------------------------
# Feign client identifier for scoped operations
NNP_FEIGN_NAME=nnp-gitlab-client

# Base URL for secondary GitLab instance (defaults to FEIGN_URL if same instance)
NNP_FEIGN_URL=https://gitlab.example.com

# Personal Access Token for secondary instance
NNP_FEIGN_APITOKEN=glpat-yourSecretSecondaryTokenHere

# ------------------------------------------------------------------------------
# 4. Hazelcast In-Memory Distributed Cache (Single-Node Loopback)
# ------------------------------------------------------------------------------
# Port dedicated to the Hazelcast in-memory grid (isolated to 127.0.0.1)
HAZELCAST_PORT=5701

# Cache Refresh Cron Expression (Default: Hourly on the hour)
CACHE_REFRESH_CRON=0 0 * * * *

# ------------------------------------------------------------------------------
# 5. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# URL for centralized Spring Cloud Config Server (if used)
CONFIG_SERVER_URL=http://localhost:8888
